/*
 * secrets.h.example  —  template for your private values
 * ---------------------------------------------------------------------------
 * Copy this file to `secrets.h` (same folder) and fill in real values. The
 * real `secrets.h` is git-ignored, so your keys and passwords never get
 * committed. config.h includes it automatically when present, and anything
 * defined here overrides the placeholders in config.h.
 *
 *   cp src/secrets.h.example src/secrets.h    # then edit src/secrets.h
 *
 * NEVER commit a filled-in secrets.h or paste real keys into config.h.
 * ---------------------------------------------------------------------------
 */
#ifndef VPN_GATEWAY_SECRETS_H
#define VPN_GATEWAY_SECRETS_H

/* WiFi */
#define WIFI_SSID          "my-home-ssid"
#define WIFI_PASSWORD      "my-home-password"

/* WireGuard (from docs/server-setup/setup-wireguard-server.sh output) */
#define WG_LOCAL_IP        "10.6.0.2"
#define WG_PRIVATE_KEY     "device-private-key-base64="
#define WG_PEER_PUBLIC_KEY "server-public-key-base64="
#define WG_ENDPOINT_HOST   "vpn.example.com"

/* Optional: pre-shared key for an extra symmetric (PQ-hardening) layer. */
/* #define WG_PRESHARED_KEY "preshared-key-base64=" */

/* Optional: require this token to view the status page (Bearer or ?token=). */
/* #define STATUS_SERVER_TOKEN "a-long-random-string" */

#endif /* VPN_GATEWAY_SECRETS_H */
