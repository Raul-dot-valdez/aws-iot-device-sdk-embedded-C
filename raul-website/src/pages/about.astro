---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Raul Valdez">
  <h1>About me</h1>
  <p>
    This is the About page. Edit this text in
    <code>src/pages/about.astro</code> to tell visitors who you are, what you do,
    and what this site is about.
  </p>
  <p>
    Because this is a regular page (not a blog post), you change it by editing
    the file directly. Your blog posts, on the other hand, are managed from the
    <a href="/admin/">admin panel</a> — no code required.
  </p>
</BaseLayout>
